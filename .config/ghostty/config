# https://ghostty.org/docs/config/reference

# theme = catppuccin-mocha
# font-size = 14

mouse-hide-while-typing = true
window-height = 60
window-width = 180

# Hyper+g - quick terminal
keybind = global:cmd+ctrl+alt+shift+g=toggle_quick_terminal
quick-terminal-position=center
# only left option behaves as alt, the right still can be used for Unicode input
macos-option-as-alt = left
background-opacity = 0.95

# Delete to the beginning-of-line, requires to add in `.zshrc` to enable Ctlr-U in zsh:
# `bindkey \^U backward-kill-line`
keybind = cmd+backspace=text:\x15

# Rename tab title
keybind = cmd+shift+r=prompt_surface_title

# Claude Code compatibility
keybind = shift+enter=text:\x1b\r

# SSH compatibility (fix "Error opening terminal: xterm-ghostty")
shell-integration-features = ssh-env,ssh-terminfo

# 5x default, bytes
scrollback-limit = 50000000

