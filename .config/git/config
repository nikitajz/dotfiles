[includeIf "gitdir:~/projects/"]
  path = ~/projects/.gitconfig
[include]
  path = config.local
[push]
	autoSetupRemote = true
[pager]
  diff = delta
[diff]
  tool = difft
[difftool "vscode"]
 	cmd = code --wait --diff $LOCAL $REMOTE
[pretty]
	better-oneline = "format:%C(auto)%h%d %s %C(blue)<%cn>"
  # use '%ad' instead of '%cd' to show accurate commit dates (e.g. squash, etc)
  oneline-dates = "format:%C(bold green)%h%Creset %C(cyan)%ad%Creset%C(auto)%d%Creset %s%Cblue <%cn>"
  oneline-dates-end = "format:%C(bold green)%h%Creset %C(auto)%d%Creset %s%Cblue <%cn> %C(cyan)(%ad)"
[alias]
  amend = commit --amend --verbose
  # reverts the last commit, keeping the changes unstaged
  undo = reset --mixed HEAD~1
  # resets the working directory and index to the last commit, discarding all the changes
  res = !git reset --hard
  # reverts the last commit, keeping the changes staged in the index
  uncommit = reset --soft HEAD~1
  # restore staged file(s)
  unstage = restore --staged # <file>...
  # list all remotes and their URLs
  remotes = remote -v
  # list tags (all or matching pattern) 
  tags = tag -l #[PATTERN]
  # list all aliases
  aliases = "!git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ / | grep -v ^'alias '"
  # show logs as graph/tree
	tree  = log --pretty=better-oneline --all --graph
  graph = log --pretty=better-oneline -graph
  structure = log --oneline --simplify-by-decoration --graph --all
  # no pager
  nlog = "!git --no-pager log --decorate=short --pretty=short"
  # last commit details with changed files
  last = log --stat -1 HEAD

  # shortcuts
  a = add
  b = branch
  # extended format with author name, commit date and ahead/behind
  be = "branch --format=\"%(HEAD) %(color:bold green)%(refname:short)%(color:reset) %(color:blue)<%(authorname)> %(color:cyan)(%(committerdate:relative)) %(color:bold red)%(upstream:track)%(color:reset) \n%(contents:subject)\" --sort=-committerdate"
  # rename (move) local branch
  bm = branch -m # <old_branch> <new_branch>
  co = checkout
  cb = checkout -b
  # modify last commit
  m = commit --amend 
  ci = commit
  cm = commit -m # <message>
  ca = commit --all
  cam = commit --all -m # <message>
  d = diff
  # summarized view of changes
  ds = diff --stat
  # shows staged changes, useful before commiting
  dc = diff --cached
  # diff tool (vsdode atm)
  dt = difftool
  lg = graph
  ls = log --pretty=better-oneline
  ld = log --pretty=oneline-dates-end --date=relative
  lds = log --pretty=oneline-dates --date=short
  ldr = log --pretty=oneline-dates-end --date=relative
  # show modified files with number of added and removed lines
  ll = log --pretty=better-oneline --numstat
  # no pager
  l5 = nlog -5
  # list aliases
  la = alias
  sw = switch # <branch>
  # status summary/short
  ss = status -s
  st = status
  u = pull
  p = push
  pf = push --force-with-lease

  # Difftastic
  dlog = -c diff.external=difft log --ext-diff
  dshow = -c diff.external=difft show --ext-diff
  ddiff = -c diff.external=difft diff

  # Difftastic short
  tl = -c diff.external=difft log -p --ext-diff
  ts = -c diff.external=difft show --ext-diff
  td = -c diff.external=difft diff

  ## branch status (detection only, read-only)
  # upstream deleted (remote was deleted after push)
  # awk gsub strips leading '* ' and '+' (worktree) so branch name is captured correctly in all cases
  gone = "!git branch -vv | grep ': gone]' | awk '{gsub(/^[* +]+/, \"\"); print $1}'"
  # local only, never pushed – never auto-deleted
  orphan = "!git for-each-ref --format='%(refname:short) %(upstream)' refs/heads | awk '$2 == \"\" {print $1}' | grep -Ev '^(main|master|dev)$'"
  # branches fully merged into base via regular merge
  merged = "!f() { \
    base=${1:-$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')}; \
    [ -z \"$base\" ] && base=main; \
    git rev-parse --verify \"$base\" >/dev/null 2>&1 || base=\"origin/$base\"; \
    git branch --merged \"$base\" | awk '{gsub(/^[* +]+/, \"\"); print}' | grep -Ev '^(main|master|dev)$'; \
  }; f"
  # branches squash-merged into base (invisible to --merged):
  # creates a throwaway squash commit from the branch tree and checks if it already landed in base via git cherry
  # only checks branches with a configured upstream (i.e. were pushed) – orphans can't have been PR-merged
  squashed = "!f() { \
    base=${1:-$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')}; \
    [ -z \"$base\" ] && base=main; \
    git rev-parse --verify \"$base\" >/dev/null 2>&1 || base=\"origin/$base\"; \
    regular=$(git branch --merged \"$base\" | awk '{gsub(/^[* +]+/, \"\"); print}'); \
    git for-each-ref refs/heads/ --format='%(refname:short) %(upstream:short)' | while read branch upstream; do \
      [ -z \"$upstream\" ] && continue; \
      echo \"$regular\" | grep -qxF \"$branch\" && continue; \
      mb=$(git merge-base \"$base\" \"$branch\" 2>/dev/null) || continue; \
      sq=$(git commit-tree $(git rev-parse \"$branch^{tree}\") -p \"$mb\" -m _) || continue; \
      git cherry \"$base\" \"$sq\" 2>/dev/null | grep -q '^-' && echo \"$branch\"; \
    done | grep -Ev '^(main|master|dev)$'; \
  }; f"
  # branches with no commits in the last N months (default: 3) – informational only, never auto-deleted
  stale = "!f() { \
    period=${1:-3}; \
    git for-each-ref refs/heads/ --format='%(refname:short)' | while read branch; do \
      [ -z \"$(git log -1 --since=\"${period} months ago\" -s \"$branch\" 2>/dev/null)\" ] && echo \"$branch\"; \
    done | grep -Ev '^(main|master|dev)$'; \
  }; f"

  ## branch cleanup – all commands skip branches active in any worktree
  prune-gone = "!all=$(git gone); \
    wt=$(git worktree list --porcelain 2>/dev/null | sed -n 's/^branch refs\\/heads\\///p'); \
    if [ -n \"$wt\" ]; then branches=$(echo \"$all\" | grep -vxF \"$wt\"); skipped=$(echo \"$all\" | grep -xF \"$wt\"); \
    else branches=$all; skipped=; fi; \
    if [ -n \"$branches\" ]; then echo \"Deleting gone branches:\"; echo \"$branches\"; echo \"$branches\" | xargs -I{} git branch -D {}; fi; \
    if [ -n \"$skipped\" ]; then echo \"Skipped (active in worktree):\"; echo \"$skipped\"; fi; \
    [ -z \"$all\" ] && echo \"No gone branches\"; true"
  # -d (safe): git refuses to delete branches not fully merged
  prune-merged = "!f() { \
    all=$(git merged \"$1\"); \
    wt=$(git worktree list --porcelain 2>/dev/null | sed -n 's/^branch refs\\/heads\\///p'); \
    if [ -n \"$wt\" ]; then branches=$(echo \"$all\" | grep -vxF \"$wt\"); skipped=$(echo \"$all\" | grep -xF \"$wt\"); \
    else branches=$all; skipped=; fi; \
    if [ -n \"$branches\" ]; then echo \"Deleting merged branches:\"; echo \"$branches\"; echo \"$branches\" | xargs -I{} git branch -d {}; fi; \
    if [ -n \"$skipped\" ]; then echo \"Skipped (active in worktree):\"; echo \"$skipped\"; fi; \
    [ -z \"$all\" ] && echo \"No merged branches\"; true; \
  }; f"
  # -D (force): squash commits are not recognised as merged by git
  prune-squashed = "!f() { \
    all=$(git squashed \"$1\"); \
    wt=$(git worktree list --porcelain 2>/dev/null | sed -n 's/^branch refs\\/heads\\///p'); \
    if [ -n \"$wt\" ]; then branches=$(echo \"$all\" | grep -vxF \"$wt\"); skipped=$(echo \"$all\" | grep -xF \"$wt\"); \
    else branches=$all; skipped=; fi; \
    if [ -n \"$branches\" ]; then echo \"Deleting squash-merged branches:\"; echo \"$branches\"; echo \"$branches\" | xargs -I{} git branch -D {}; fi; \
    if [ -n \"$skipped\" ]; then echo \"Skipped (active in worktree):\"; echo \"$skipped\"; fi; \
    [ -z \"$all\" ] && echo \"No squash-merged branches\"; true; \
  }; f"
  # fetch + delete gone, merged, squash-merged (orphan and stale are never touched)
  prune = "!git fetch --prune && git prune-gone && git prune-merged && git prune-squashed"

  # read-only overview of all branch categories; uses ';' + '|| true' so empty sections don't abort
  sweep = "!git fetch --prune; \
    echo '── Gone (upstream deleted) ──'; git gone || true; echo; \
    echo '── Merged ──'; git merged || true; echo; \
    echo '── Squash-merged ──'; git squashed || true; echo; \
    echo '── Orphan (local only, never pushed) ──'; git orphan || true; echo; \
    echo '── Stale (no commits in 3+ months) ──'; git stale || true"

